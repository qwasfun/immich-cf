{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "immich-cf-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "vars": {
    "APP_ENV": "development",
    "APP_VERSION": "0.1.0",
    "ENABLE_P1_POC": "true"
  },
  "d1_databases": [
    {
      "binding": "IMMICH_CF_DB",
      "database_name": "immich-cf-db-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMMICH_CF_MEDIA",
      "bucket_name": "immich-cf-media-local",
      "remote": false
    }
  ]
}
