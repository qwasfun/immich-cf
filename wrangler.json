{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "immich-cf-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "vars": {
    "APP_ENV": "production",
    "APP_VERSION": "0.1.0",
    "ENABLE_P1_POC": "false"
  },
  "d1_databases": [
    {
      "binding": "IMMICH_CF_DB",
      "database_name": "immich-cf-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMMICH_CF_MEDIA",
      "bucket_name": "immich-cf-media"
    }
  ],
  "env": {
    "dev": {
      "name": "immich-cf-api-dev",
      "account_id": "f94fe289bd879e05e4a9faac06dfdf40",
      "vars": {
        "APP_ENV": "development",
        "APP_VERSION": "0.1.0",
        "ENABLE_P1_POC": "true"
      },
      "d1_databases": [
        {
          "binding": "IMMICH_CF_DB",
          "database_name": "immich-cf-db-dev",
          "database_id": "a8754a88-bb89-4d30-af2a-e19a793b253e",
          "migrations_dir": "migrations",
          "remote": true
        }
      ],
      "r2_buckets": [
        {
          "binding": "IMMICH_CF_MEDIA",
          "bucket_name": "immich-cf-media-dev",
          "remote": true
        }
      ],
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "invocation_logs": true,
          "head_sampling_rate": 1
        }
      },
      "triggers": {
        "crons": ["*/5 * * * *"]
      }
    },
    "test": {
      "name": "immich-cf-api-test",
      "vars": {
        "APP_ENV": "test",
        "APP_VERSION": "0.1.0",
        "ENABLE_P1_POC": "false"
      },
      "d1_databases": [
        {
          "binding": "IMMICH_CF_DB",
          "database_name": "immich-cf-db-test",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "IMMICH_CF_MEDIA",
          "bucket_name": "immich-cf-media-test"
        }
      ]
    },
    "prod": {
      "name": "immich-cf-api",
      "vars": {
        "APP_ENV": "production",
        "APP_VERSION": "0.1.0",
        "ENABLE_P1_POC": "false"
      },
      "d1_databases": [
        {
          "binding": "IMMICH_CF_DB",
          "database_name": "immich-cf-db",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "IMMICH_CF_MEDIA",
          "bucket_name": "immich-cf-media"
        }
      ]
    }
  },
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "f94fe289bd879e05e4a9faac06dfdf40"
}
